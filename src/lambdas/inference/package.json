{
  "name": "tw-aichatbot-inference",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "node local.mjs",
    "clean": "rimraf dist lambda lambda.zip",
    "build:lambda": "esbuild index.mjs --bundle --minify --sourcemap --platform=node --target=es2020 --outfile=lambda/index.js && cp lambda-runner.sh lambda/run.sh",
    "zip:lambda": "cd lambda && zip -r -9 ../lambda.zip ./* && cd ..",
    "lambda": "npm run clean && npm run build:lambda && npm run zip:lambda"
  },
