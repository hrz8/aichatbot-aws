    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "js-yaml": "^4.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@aws-sdk/types": "^3.901.0",
    "esbuild": "^0.25.10",
    "rimraf": "^6.0.1"
  }
}
